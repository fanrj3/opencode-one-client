    "bin",
    "opencode-one-client.example.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "devices",
    "remote",
    "tailscale",
    "tui",
    "cli"
  ],
