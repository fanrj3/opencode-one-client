  "author": "fanrj3",
  "engines": {
    "opencode": "^2.0.0",
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fanjr3/opencode-one-client.git"
  },
  "homepage": "https://github.com/fanjr3/opencode-one-client",
  "devDependencies": {
    "@opencode/plugin": "^2.0.26"
  }
